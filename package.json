{
  "name": "react-router-lambda-web-function",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && node scripts/bundle.mjs",
    "dev": "react-router dev",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,md}\"",
    "check": "npm run format:check && npm run typecheck && npm run build && npm run smoke"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@remix-run/node-fetch-server": "^0.14.2",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  }
}
